# TrackID behind TLS. The nginx image fills in ${SERVER_NAME} and ${MAP_TILE_ORIGIN} from
# deploy/.env when it starts; nginx's own $variables are left alone.

# Sign-in attempts per client address (SECURITY.md: the application itself doesn't limit them).
# Behind another proxy every client shares its address: see docs/deployment.md.
limit_req_zone $binary_remote_addr zone=login:10m rate=10r/m;

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

upstream trackid_api {
    server api:8082;
    keepalive 16;
}

server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name ${SERVER_NAME};
    return 301 https://$host:${HTTPS_PORT}$request_uri;
}

server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    http2 on;
    server_name ${SERVER_NAME};

    ssl_certificate     /etc/nginx/certs/tls.crt;
    ssl_certificate_key /etc/nginx/certs/tls.key;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:TLS:10m;
    ssl_session_timeout 1d;

    server_tokens off;

    # The video lab and a case's videos take files of up to 1 GiB.
    client_max_body_size 1100m;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "same-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    # Everything comes from this origin except the map's tiles. WebAssembly is for the report
    # editor; inline styles are the map's and React's.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: ${MAP_TILE_ORIGIN}; connect-src 'self' ${MAP_TILE_ORIGIN}; font-src 'self'; worker-src 'self' blob:; frame-src 'self'; frame-ancestors 'self'; object-src 'none'; base-uri 'self'; form-action 'self'" always;

    proxy_http_version 1.1;
    proxy_set_header Host              $http_host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Connection        "";
    # A question to the AI mode or a draft from the assist model can take minutes.
    proxy_read_timeout 600s;
    proxy_send_timeout 600s;

    location = /api/auth/login {
        limit_req zone=login burst=10 nodelay;
        limit_req_status 429;
        proxy_pass http://trackid_api;
    }

    # Live updates (docs/realtime-plan.md): one WebSocket per tab, kept open.
    location = /api/realtime {
        proxy_pass http://trackid_api;
        # Setting any header here drops the server's, so all of them again.
        proxy_set_header Host              $http_host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
    }

    # The report editor (WordCraft), when compose.wordcraft.yml mounts it. Its page starts its
    # WebAssembly from an inline script whose hash changes with every build, so this path allows
    # inline scripts; it is a static page on this origin, with no user content in it. A location
    # that sets a header drops the server's, so all of them again.
    location /wordcraft/ {
        proxy_pass http://trackid_api;
        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "same-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self'; font-src 'self' data:; worker-src 'self' blob:; frame-ancestors 'self'; object-src 'none'; base-uri 'self'; form-action 'self'" always;
    }

    # The API's own health and readiness are for the stack, not the outside.
    location /health {
        return 404;
    }
    location = /ready {
        return 404;
    }

    location / {
        proxy_pass http://trackid_api;
    }
}
