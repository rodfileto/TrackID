# TrackID production settings, for deploy/compose.yml. Copy to deploy/.env (kept out of git) and
# fill it in. An empty required value stops `docker compose up` with a message naming it.
# docs/deployment.md explains each part.
#
# Generate secrets with `openssl rand -hex 32`: hex needs no escaping in the URLs and the
# storage configuration these values go into.

# --- Version and address ------------------------------------------------------------------------
# The release to run (a tag such as v0.3.0). To build the images here instead of pulling them,
# set any name (e.g. local) and run `docker compose build`.
TRACKID_VERSION=
# The host name users open, which the TLS certificate in ./certs must cover.
SERVER_NAME=
# The same, as a URL: the link in Teams messages.
APP_URL=

# --- Secrets (required) ---------------------------------------------------------------------------
# Signs sign-in tokens. Changing it signs everyone out.
JWT_SECRET=
POSTGRES_PASSWORD=
REDIS_PASSWORD=
S3_ACCESS_KEY=trackid
S3_SECRET_KEY=

# --- Evidence storage -----------------------------------------------------------------------------
S3_BUCKET=trackid-evidence
# How many days each stored file can't be deleted or overwritten, by anyone, including whoever
# holds the storage keys (S3 object lock, COMPLIANCE mode). This is the institute's retention
# policy, so there is no default. It applies to files stored from then on; raising or lowering it
# later doesn't change files already stored. See docs/deployment.md, "Evidence retention".
S3_RETENTION_DAYS=

# --- Map ------------------------------------------------------------------------------------------
# The base map's raster tiles. Empty means OpenStreetMap's public servers, which allow light use
# only and see which areas users look at; an institute normally sets its own tile server.
MAP_TILE_URL=
MAP_TILE_ATTRIBUTION=
# The tile server's origin (scheme and host), which the browser is allowed to fetch from.
MAP_TILE_ORIGIN=https://tile.openstreetmap.org

# --- Optional integrations --------------------------------------------------------------------------
# Each is off when left empty; ../.env.example describes them in full.
#
# Accounts get "<username>@<EMAIL_DOMAIN>" as their email.
EMAIL_DOMAIN=
# Geocoding: a Nominatim server of the institute's own. Empty uses OpenStreetMap's public one, which
# then receives the addresses typed into occurrences.
GEOCODER_URL=
GEOCODER_EMAIL=
# Microsoft Teams messages: SECRETS_KEY (openssl rand -base64 32) encrypts users' webhooks.
SECRETS_KEY=
TEAMS_LANGUAGE=pt-BR
# A language model (OpenAI-compatible server) for drafting registrations and the AI mode.
ASSIST_ENDPOINT=
ASSIST_MODEL=
ASSIST_API_KEY=
ASK_ENDPOINT=
ASK_MODEL=
ASK_API_KEY=

# --- Optional services in this stack (profiles; docs/deployment.md) -------------------------------
# A Nominatim of its own (`--profile nominatim`): the OpenStreetMap extract to import, e.g.
# https://download.geofabrik.de/south-america/brazil/sudeste-latest.osm.pbf, and its updates. Then
# set GEOCODER_URL=http://nominatim:8080 above.
NOMINATIM_PBF_URL=
NOMINATIM_REPLICATION_URL=
NOMINATIM_UPDATE_MODE=none
NOMINATIM_PASSWORD=
# A language model server (`--profile llm`): set ASSIST_ENDPOINT=http://ollama:11434/v1 and
# ASSIST_MODEL above, after pulling the model.
# The GPU image for compose.gpu.yml (built with Dockerfile.gpu).
TRACKID_GPU_IMAGE=

# --- Host -----------------------------------------------------------------------------------------
HTTP_PORT=80
HTTPS_PORT=443
# Where the TLS certificate (tls.crt, the full chain) and its key (tls.key) are.
TLS_CERT_DIR=./certs
# Where fetch-models.sh put the face models.
MODELS_DIR=./models
# How many background tasks the worker runs at once.
WORKER_CONCURRENCY=10
# Evidence storage (SeaweedFS): the size of each volume file, and the share of the disk, in percent,
# below which storage turns read-only rather than fill the disk. See seaweedfs/start.sh.
SEAWEEDFS_VOLUME_SIZE_MB=4096
SEAWEEDFS_MIN_FREE=5
# The in-memory /tmp of the API and the worker, where videos are processed.
TMP_SIZE=3g
