# TrackID local development environment.
#
# Copy this file to `.env` and adjust values as needed. `.env` is gitignored;
# `.env.example` is the documented reference. scripts/start_dev.sh sources `.env`
# when present, and the Go command-line tools load it via the `internal/env`
# package (from the repo root).
#
# Every value below matches the defaults already used by docker-compose.yml and
# the scripts, so a plain `cp .env.example .env` gives a working stack.

# --- API server (cmd/trackid) -------------------------------------------------
PORT=8082
DATABASE_URL=postgres://trackid:trackid_dev@localhost:55432/trackid?sslmode=disable
REDIS_URL=redis://localhost:56379/0
JWT_SECRET=local-development-secret
# Optional. When set, registered users get "<username>@<EMAIL_DOMAIN>"; when
# empty, their email is just the username.
EMAIL_DOMAIN=
# Optional. Override where the server looks for the built frontend (defaults to
# frontend/dist under the repo root).
# TRACKID_WEB_DIST=frontend/dist

# --- Neo4j graph --------------------------------------------------------------
# START_NEO4J=true also starts the neo4j container via docker compose
# (profile "graph"). The graph-writing commands (sync-graph, sync-identity,
# cluster-biometrics, identify) read NEO4J_URL + NEO4J_USERNAME +
# NEO4J_PASSWORD, so set all three to run them with -commit.
START_NEO4J=true
NEO4J_URL=bolt://localhost:57687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=neo4j_dev

# --- Object storage (scripts/backup_data.sh / restore_data.sh) ---------------
S3_ENDPOINT=http://localhost:59000
S3_ACCESS_KEY=trackid
S3_SECRET_KEY=trackid_dev_storage
S3_BUCKET=trackid-local

# --- Vision: face detection + embedding ---------------------------------------
# github.com/rodfileto/trackid-vision. The API uses it for face detection on
# evidence (POST .../detect-faces); cmd/worker uses it for
# embedding.TaskTypeComputeCodification. Left empty, both log a warning and run
# without it rather than failing to start -- see its README for where to get
# the ONNX weights and onnxruntime build. See README "Models and licences":
# the SCRFD detector is non-commercial research only.
#
# Which detector VISION_DETECTOR_PATH holds: "yunet" (default, MIT) or "scrfd".
# Embeddings from the two are not comparable -- re-embed after switching.
VISION_DETECTOR=yunet
VISION_DETECTOR_PATH=
VISION_RECOGNIZER_PATH=
# Optional; trackid-vision has its own default.
VISION_SHARED_LIBRARY_PATH=
# Optional. "true" to use the CUDA execution provider; falls back to CPU if
# unavailable.
VISION_USE_GPU=false
# Only used when VISION_USE_GPU=true: a directory containing the CUDA/cuDNN
# runtime libraries libonnxruntime_providers_cuda.so needs at load time
# (libcudart/libcublas/libcublasLt/libcudnn*/libcufft/libcurand/libnvrtc).
# Without a full system CUDA toolkit install, these can be pulled from PyPI's
# nvidia-*-cu12 wheels (each is just a zip -- no pip/sudo needed) and their
# lib/*.so* files copied into one directory. IMPORTANT: this must be set in
# the actual shell environment before the Go binary execs -- glibc's dynamic
# linker reads LD_LIBRARY_PATH once at process start, so setting it via
# godotenv from inside the program (like every other var here) is too late.
# `set -a; source .env; set +a` before `go run ...` (as start_dev.sh and
# scripts/*.sh already do) works; `go run ...` on its own does not.
LD_LIBRARY_PATH=

# --- Fingerprint: SourceAFIS extraction + matching -----------------------------
# sourceafis-sidecar/, run as its own docker-compose service. Used by
# cmd/worker for fingerprint:extract_codification/fingerprint:extract_identity_feature/
# fingerprint:sync (the fingerprint package). Left empty, fingerprint tasks
# aren't processed -- fingerprint enrollments/lifts are still stored, just
# without a template or a SYSTEM match. Matches the docker-compose host port.
FINGERPRINT_SIDECAR_URL=http://localhost:58090
