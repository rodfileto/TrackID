# The application image with GPU (CUDA) face detection and embedding: the commands and frontend of
# an application image (TRACKID_IMAGE, built from Dockerfile or pulled), on NVIDIA's CUDA runtime
# with the GPU build of onnxruntime. Not published: an institute with a GPU builds it, and runs it
# with deploy/compose.gpu.yml (docs/deployment.md, "GPU").
#
#   docker build -f Dockerfile.gpu --build-arg TRACKID_IMAGE=ghcr.io/rodfileto/trackid:v0.3.0 \
#     -t trackid:v0.3.0-cuda .
#
# The host needs an NVIDIA driver for CUDA 12 and the NVIDIA Container Toolkit.

ARG TRACKID_IMAGE
ARG GO_VERSION=1.27.3

FROM ${TRACKID_IMAGE} AS app

# onnxruntime's GPU build, the version Dockerfile's CPU one is: the library and the CUDA provider,
# which it loads from its own directory. curl and sha256sum rather than ADD --checksum, so the
# classic builder builds it too.
FROM golang:${GO_VERSION}-bookworm AS onnxruntime
ARG ORT_VERSION=1.22.0
ARG ORT_SHA256=2a19dbfa403672ec27378c3d40a68f793ac7a6327712cd0e8240a86be2b10c55
RUN curl -fsSL -o /tmp/ort.tgz \
        https://github.com/microsoft/onnxruntime/releases/download/v${ORT_VERSION}/onnxruntime-linux-x64-gpu-${ORT_VERSION}.tgz \
    && echo "${ORT_SHA256}  /tmp/ort.tgz" | sha256sum -c - \
    && tar -xzf /tmp/ort.tgz -C /tmp \
    && mkdir -p /opt/onnxruntime \
    && lib=/tmp/onnxruntime-linux-x64-gpu-${ORT_VERSION}/lib \
    && cp $lib/libonnxruntime.so.${ORT_VERSION} /opt/onnxruntime/libonnxruntime.so \
    && cp $lib/libonnxruntime_providers_shared.so $lib/libonnxruntime_providers_cuda.so /opt/onnxruntime/

# CUDA 12 with cuDNN 9, which onnxruntime 1.22's CUDA provider needs.
FROM nvidia/cuda:12.9.2-cudnn-runtime-ubuntu24.04
RUN apt-get update \
    && apt-get upgrade -y --no-install-recommends \
    && apt-get install -y --no-install-recommends ca-certificates curl ffmpeg tzdata \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --system --uid 10001 --user-group --home-dir /app --no-create-home trackid

COPY --from=onnxruntime /opt/onnxruntime /opt/onnxruntime
COPY --from=app /usr/local/bin/ /usr/local/bin/
COPY --from=app /app/web /app/web

ENV PORT=8082 \
    TRACKID_WEB_DIST=/app/web \
    VISION_SHARED_LIBRARY_PATH=/opt/onnxruntime/libonnxruntime.so \
    VISION_USE_GPU=true \
    VISION_DETECTOR=yunet \
    VISION_DETECTOR_PATH=/models/face_detection_yunet_2026may.onnx \
    VISION_RECOGNIZER_PATH=/models/glintr100.onnx

WORKDIR /app
USER 10001:10001
EXPOSE 8082
CMD ["trackid"]

LABEL org.opencontainers.image.title="TrackID (CUDA)" \
      org.opencontainers.image.source="https://github.com/rodfileto/trackid" \
      org.opencontainers.image.licenses="Apache-2.0"
