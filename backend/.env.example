DEBUG=False
DATABASE_URL=postgresql+asyncpg://postgres:password@postgres:5432/trackid
REDIS_URL=redis://redis:6379

# Face detection (InsightFace/buffalo_l). Requires requirements-gpu.txt
# to be installed (see README) - falls back to CPU otherwise.
FACE_USE_GPU=False

# Face quality estimation (MagFace). Optional - if the model file isn't
# present at FACE_QUALITY_MODEL_PATH, quality_score is simply omitted from
# detection results. See backend/models/README.txt for download info.
# FACE_QUALITY_MODEL_PATH=/app/models/magface_iresnet50.onnx
# Same GPU requirement as FACE_USE_GPU above.
FACE_QUALITY_USE_GPU=False
