@prefix obo:  <http://purl.obolibrary.org/obo/> .
@prefix cco:  <https://www.commoncoreontologies.org/> .
@prefix tid:  <https://trackid.example.org/ontology/> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

# ── Physical layer (the referent) ─────────────────────────────────────────
# cco:Person is reused directly — no TargetEntity, no tid:Person wrapper.
# "Unidentified" is a STATE (a :Person with no name, no IDENTIFIES link),
# not a class. The "cluster" is emergent: N FaceRecords face_record_of the
# same Person.

tid:Face a owl:Class ;
    rdfs:subClassOf obo:BFO_0000024 ;
    rdfs:label "Face"@en ;
    skos:definition "Frontal surface region of a human head, demarcated by fiat boundaries; the biometric characteristic."@en .

# ── Digital layer (the representation) ────────────────────────────────────
tid:FaceRecord a owl:Class ;
    rdfs:subClassOf obo:BFO_0000031 ;
    rdfs:label "Face Record"@en ;
    skos:definition "A digital record of one observation or enrollment of a person's face: image + embedding + provenance."@en .

tid:FaceImage a owl:Class ;
    rdfs:subClassOf cco:ont00002004 ;
    rdfs:label "Face Image"@en .

tid:FaceEmbedding a owl:Class ;
    rdfs:subClassOf cco:ont00001163 ;
    rdfs:label "Face Embedding"@en ;
    skos:definition "Fixed-length numeric vector derived from a Face Image."@en .

# provenance split — the dual-source distinction
tid:SurveillanceFaceImage a owl:Class ;
    rdfs:subClassOf tid:FaceImage ;
    rdfs:label "Surveillance Face Image"@en ;
    skos:definition "Face Image captured by a surveillance device (e.g. CCTV); subject typically unidentified."@en .

tid:EnrollmentFaceImage a owl:Class ;
    rdfs:subClassOf tid:FaceImage ;
    rdfs:label "Enrollment Face Image"@en ;
    skos:definition "Face Image that is part of an identity document (e.g. passport photo); tied to a claimed identity."@en .

# ── Relations ─────────────────────────────────────────────────────────────
tid:face_record_of a owl:ObjectProperty ;
    rdfs:domain tid:FaceRecord ;
    rdfs:range cco:ont00001262 ;
    rdfs:label "face record of"@en .

tid:has_face_record a owl:ObjectProperty ;
    owl:inverseOf tid:face_record_of ;
    rdfs:domain cco:ont00001262 ;
    rdfs:range tid:FaceRecord ;
    rdfs:label "has face record"@en .

tid:depicts a owl:ObjectProperty ;
    rdfs:domain tid:FaceImage ;
    rdfs:range tid:Face ;
    rdfs:label "depicts"@en .

tid:derived_from a owl:ObjectProperty ;
    rdfs:domain tid:FaceEmbedding ;
    rdfs:range tid:FaceImage ;
    rdfs:label "derived from"@en .

tid:has_face_image a owl:ObjectProperty ;
    rdfs:domain tid:FaceRecord ;
    rdfs:range tid:FaceImage ;
    rdfs:label "has face image"@en .

tid:has_face_embedding a owl:ObjectProperty ;
    rdfs:domain tid:FaceRecord ;
    rdfs:range tid:FaceEmbedding ;
    rdfs:label "has face embedding"@en .
